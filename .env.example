# ==============================================================
# AI Sales Calling Agent - Environment Configuration Template
# Copy this file to .env and replace the placeholder values.
# NEVER commit your actual .env file to GitHub or public repositories.
# ==============================================================

# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GENIE_MODEL_NAME=gemini-1.5-flash

# Twilio Voice API Credentials (from Twilio Console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Public Production Base URL (Assigned by Render when deployed)
# Example: https://ai-sales-calling-agent.onrender.com
PUBLIC_BASE_URL=https://your-app-name.onrender.com

# Optional: Default number for CLI testing (e.g. python call.py)
STUDENT_PHONE_NUMBER=+919876543210

# Optional: Set to true/1 to simulate calls without dialing Twilio carrier
SIMULATE_MODE=false
